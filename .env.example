# Browser (inlined at build time)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server / SSR (must match the same Supabase project)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_PROJECT_ID=your-project-id

# Server only — never expose to the client. Required to delete accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Drizzle migrations (CLI only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Optional: authenticate scheduled jobs when a cron route is added
CRON_SECRET=
CRON_SECRET_PREVIOUS=
